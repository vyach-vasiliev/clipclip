{
  "name": "electron-vue-vite",
  "version": "28.1.0",
  "main": "dist-electron/main/index.js",
  "description": "Really simple clipboard history manager.",
  "author": "Viacheslav Vasilev",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build:app": "npm run typecheck && vite build",
    "build": "npm run build:app && electron-builder --publish never",
    "preview": "vite preview",
    "build:mac": "npm run build:app && electron-builder --mac --publish never",
    "build:linux": "npm run build:app && electron-builder --linux --publish never",
    "build:win": "npm run build:app && electron-builder --win --publish never",
    "build:win-portable": "npm run build:app && electron-builder --win portable --publish never",
    "build:vite-win-portable": "npm run build:win-portable",
    "test:electron": "node scripts/electron-smoke.mjs"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13",
    "vue": "^3.5.43",
    "pinia": "^3.0.1",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.6"
  },
  "dependencies": {
    "get-windows": "^9.3.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "@electron/get": "^5.1.0"
  }
}
